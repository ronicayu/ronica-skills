#!/usr/bin/env bash
#
# Run evs.py, the evidence-search index tool, with the interpreter that
# python-path.sh picks. It finds its own directory, even through a symlink,
# so it runs from any working directory. Arguments and the exit code pass
# through unchanged.
#
# Usage: "${CLAUDE_PLUGIN_ROOT}/scripts/evs" <command> [args]

set -euo pipefail

# here PATH: print the physical directory that holds PATH.
here() {
  local dir=$1
  if [[ $dir == */* ]]; then dir=${dir%/*}; else dir=.; fi
  (CDPATH= cd -P "${dir:-/}" && pwd)
}

# Follow symlinks to the real file. macOS has no readlink -f.
self=${BASH_SOURCE[0]}
while [[ -L $self ]]; do
  target=$(readlink "$self")
  if [[ $target == /* ]]; then self=$target; else self="$(here "$self")/$target"; fi
done
script_dir=$(here "$self")

py=$("$script_dir/python-path.sh") || exit 2
exec "$py" "$script_dir/evs.py" "$@"
