stateDiagram-v2
  %% Generated by the statechart skill from plugins/agentic-team/model (overview.cfg, overview-view.mjs).
  %% Do not edit by hand: rerun the model, copy its chart.mmd here, and render it with
  %% plugins/statechart/skills/statechart/scripts/render.mjs (assets/diagrams/render.mjs skips this file).
  state "Legend" as legend {
    lg0: Start
    lg1: Working
    lg2: Verifying
    lg3: Verdict
    lg4: Closing
    lg5: End
    state "Terms" as terms {
      direction TB
      state " " as tc0 {
        direction LR
        tm0: the Manager = The Claude session that runs the team#58; it runs run.py's commands (launch, verify, close, abandon, record) and follows the next step that record prints.
        tm1: the operator = The person who owns the run#58; writes the standing orders, pauses work, repairs files and, in local mode, merges by hand.
        tm2: the task session = The Claude session that does one attempt of the task in its own worktree and files one report.
        tm3: the verifier session = The Claude session that checks the task session's work and files one verdict.
      }
      state " " as tc1 {
        direction LR
        tm4: record = run.py record, the Manager's check of every task#58; it reads the sessions and the result rows, writes what it finds, and prints the next step.
        tm5: the code host = The service that holds the request, such as GitHub, when the team merges through requests.
        tm6: a reviewer = A person who acts on the request on the code host, the operator included.
        tm7: another task = Another task of the same run, whose merge moves the target branch on.
      }
      state " " as tc2 {
        direction LR
        tm8: attempt = One run of a task session on the task#59; after the last one allowed (3 in run.py#59; a model config can set fewer), the Manager abandons the task.
        tm9: report = The task session's result row#58; PASS, ISSUES or BLOCKED.
        tm10: PASS = The task session says the work is done and checked.
        tm11: ISSUES = The task session says the work is done but has problems that need another attempt.
      }
      state " " as tc3 {
        direction LR
        tm12: BLOCKED = The work cannot go on without a decision#59; the task session or the Manager files it.
        tm13: DIED = The row that record files when a task session ended without a report.
        tm14: verdict = The verifier session's finding#58; passes, check-only or fails. Only a passing verdict lets the task merge.
        tm15: WIP = Work in progress#58; the task session's changes that are not committed yet when it pauses or stops.
      }
      state " " as tc4 {
        direction LR
        tm16: STOP order = The operator's standing order that pauses new attempts and merges until the operator lifts it.
        tm17: idle session = A task or verifier session that has filed its result and waits#59; the next attempt stops it.
        tm18: request = The pull request or merge request for the task's branch on the code host.
        tm19: merged at once = The close merges the branch, or records the task as merged because the branch has no commit to merge.
      }
    }
  }
  class lg0 blue
  class lg1 orange
  class lg2 purple
  class lg3 yellow
  class lg4 teal
  class lg5 tan
  s0: Task not started
  s1: Task session working
  s2: Task session reported ISSUES or BLOCKED
  s3: Task session reported PASS
  s4: Task session gone, no report
  s5: Attempt marked DIED, no report
  s6: Verifier session working
  s7: Verifier session gone, no verdict
  s8: Verifier session filed its verdict
  s9: Task abandoned
  s10: Verdict recorded, not closed
  s11: Task closed, waiting for the merge
  s12: Task merged
  [*] --> s0
  s0 --> s1: the Manager starts the first attempt
  s1 --> s2: the task session reports ISSUES or BLOCKED
  s1 --> s3: the task session reports PASS
  s1 --> s4: the task session ends without a report
  s3 --> s6: the Manager starts a verifier session
  s4 --> s5: the Manager's record marks the attempt DIED
  s2 --> s1: the Manager starts the next attempt
  s5 --> s1: the Manager starts the next attempt
  s6 --> s7: the verifier session ends without a verdict
  s6 --> s8: the verifier session files its verdict
  s7 --> s6: the Manager starts a verifier session
  s2 --> s9: the Manager abandons the task
  s8 --> s10: the Manager closes the task [verdict does not pass]
  s8 --> s11: the Manager closes the task [verdict passes, the merge waits]
  s8 --> s12: the Manager closes the task [verdict passes, merged at once]
  s5 --> s9: the Manager abandons the task
  s10 --> s1: the Manager starts the next attempt
  s11 --> s12: the Manager's record finds the task merged
  s10 --> s11: the Manager closes the task [verdict passes, the merge waits]
  s10 --> s12: the Manager closes the task [verdict passes, merged at once]
  s10 --> s9: the Manager abandons the task
