        tm6: spec stage = The design stage that an escalation puts before impl#59; its approval is the Manager's.
        tm7: approval = A Taskgraph decision node#59; the stages after a stage wait for it.
      }
      state " " as tc2 {
        direction LR
        tm8: instance = The parent task of the stages#59; it is done when every stage is merged and every approval answered.
      }
    }
  }
