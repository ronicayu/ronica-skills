flowchart TD
  OP([Operator])
  M[Manager<br/>playbooks + principles]
  TG[(Taskgraph<br/>plan, tasks, metadata, results)]
  CFG[config.py<br/>reads .agentic-team.toml]
  B[brief.py<br/>renders one brief per task]
  RUN[(.agentic-team/<br/>standing orders, gates, briefs)]
  W[Worker sessions<br/>one worktree per task, up to max_parallel]
  V[Verifier session<br/>high-risk tasks only]
  S[status.py]
  CON([Consultants])

  OP -->|"requests, standing orders"| M
  M -->|"batched reports, gates"| OP
  M <-->|"plan, start, meta, done"| TG
  M -->|"check, get, model"| CFG
  M -->|"render"| B
  TG -->|"task content, upstream results"| B
  CFG -->|"constraints, autonomy"| B
  RUN -->|"standing orders"| B
  M -->|"claude --bg with brief"| W
  M -->|"verifier brief"| V
  W -->|"tg result add: PASS, ISSUES, BLOCKED"| TG
  V -->|"tg result add: verdict"| TG
  TG -->|"results, read at drain points"| M
  M -->|"gates"| RUN
  W -.->|"questions"| CON
  TG --> S
  RUN --> S
  S -->|"status tables"| M
